# ==============================================================================
# CALLVAULT APPLICATION CONFIGURATION & SECRETS
# Copy this file to .env.local and update with your credentials
# ==============================================================================

# Supabase Cloud Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Server-Only Service Role Key (Keep secret! Never expose to client)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Telephony Integration (Twilio / Telnyx)
# Found in: Twilio Console Dashboard
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEPHONY_AUTH_TOKEN=your_twilio_auth_token_here

# Public Application Canonical URL (Used for webhook callbacks and auth redirects)
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
